<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/base.xml"/>
  <appender name="SCRIPT_AUDIT" class="ch.qos.logback.core.FileAppender">
    <file>demo/script-audit.log</file>
    <append>true</append>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p --- %m%n</pattern>
    </encoder>
  </appender>
  <logger name="gov.demo.vouchers.ScriptAudit" level="INFO" additivity="false">
    <appender-ref ref="SCRIPT_AUDIT"/>
  </logger>
</configuration>
